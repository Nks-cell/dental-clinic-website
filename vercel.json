{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["admin.js"]
      }
    }
  ],
  "routes": [
    {
      "src": "/admin.js",
      "dest": "/admin.js"
    },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}
